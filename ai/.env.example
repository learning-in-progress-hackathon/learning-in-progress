# Copy this file to ai/.env and fill in your real key.
# ai/.env is git-ignored; this example file is the only one that gets committed.

# Paste your key. "sk-ant-..." uses Claude; any other key uses the OpenAI-compatible API.
AI_API_KEY=REPLACE_ME

# Which model to use. Required for anything other than Claude or OpenAI itself.
# AI_MODEL=

# Where to send OpenAI-compatible requests. Auto-detected for OpenRouter (sk-or-),
# Groq (gsk_) and Gemini (AIza) keys; set it for anything else. Leave empty for OpenAI.
# AI_BASE_URL=http://localhost:11434/v1

# Optional
# AI_PROVIDER=claude        # force claude | openai if detection gets it wrong
# AI_EFFORT=medium          # reasoning effort (Claude, or OpenAI reasoning models)
# AI_MAX_TOKENS=8000        # output limit; lower it if a model rejects the request
